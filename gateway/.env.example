# Gateway local dev env. Copy to gateway/.env and tweak.
# Loaded by `gateway` entrypoint via load_dotenv() at process start.

# Postgres + Redis come from docker compose (see repo-root docker-compose.yml).
# Bring them up with: docker compose up -d postgres redis
DATABASE_URL=postgresql+asyncpg://serverlessgpu:devpassword@localhost:5432/serverlessgpu
REDIS_URL=redis://localhost:6379

GATEWAY_BIND=127.0.0.1:8080
LOG_LEVEL=INFO
# Local dev: set to 1 to auto-restart the gateway on edits under
# gateway/gateway/. Leave 0/unset in prod (single stable process).
GATEWAY_RELOAD=0

# Skip session auth — every request acts as the seeded admin user.
# Requires ADMIN_USERNAME + ADMIN_PASSWORD below so the seed runs on boot.
AUTH_DISABLED=1
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@email.com
ADMIN_PASSWORD=admin

# Turn off product surfaces platform-wide (comma-separated: inference,benchmark,compute).
# A disabled section is denied to everyone incl. admins — its nav + pages disappear
# and its routes 403. e.g. DISABLED_SECTIONS=compute hides the Compute page entirely.
DISABLED_SECTIONS=

# Fernet key for encrypting provider secrets at rest (SSH private keys, API
# tokens). Required to create GPU Providers. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this makes already-stored provider secrets undecryptable.
PROVIDER_SECRET_KEY=

# Provider off for local dev — no real GPU spawning.
AUTOSCALER=0
PROVIDER=fake

# Metrics off locally (build_metrics_env returns {} when these are empty).
METRICS_REMOTE_WRITE_URL=
METRICS_USERNAME=
METRICS_PASSWORD=

# Only needed if you flip PROVIDER=primeintellect or =runpod for real spawning.
# PI_API_KEY=
# PI_CUSTOM_TEMPLATE_ID=
# GATEWAY_PUBLIC_URL=
# RUNPOD_API_KEY=
# RUNPOD_TEMPLATE_ID=

# Reverse-tunnel mode for VM (bare-metal) serverless workers. When 1, the gateway
# forwards its own gateway port + Redis back over the SSH connection it opens to
# the VM, so a remote VM reaches them at its own localhost — no public gateway /
# Redis needed. Use for local dev or a single-gateway deploy. NOT for multi-replica
# HA (replicas would collide binding the VM's reverse port — expose WORKER_REDIS_URL
# instead). Default off.
# VM_REVERSE_TUNNEL=1

# ---------------------------------------------------------------------------
# LLM-proxy request tracing (OTLP → Tempo/Jaeger) + where the request RECORD lives
# ---------------------------------------------------------------------------
# `proxy_requests` is one Postgres row per proxied request, written on the data
# plane's hot path and never pruned by default — the wrong storage shape once the
# proxy carries real traffic. Turn tracing on and the span becomes the record; then
# PROXY_REQUEST_STORE decides how much (if any) Postgres still keeps.
#
# All of this is OFF by default: unset PROXY_TRACING + PROXY_REQUEST_STORE=all is
# byte-identical to the old behaviour.
#
# PROXY_TRACING=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4418   # where spans are WRITTEN
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf           # or `grpc` (needs the grpc exporter pkg)
# OTEL_SERVICE_NAME=gateway
# PROXY_TRACE_SAMPLE_RATIO=1.0   # ratio for SUCCESSFUL requests only — failures,
#                                # blocks, cancels and slow requests are always kept
# PROXY_TRACE_SLOW_MS=0          # 0=off; else always keep requests at/above this latency
#
# TEMPO_URL=http://localhost:3200  # where the Queue tab READS spans back (query API,
#                                  # NOT the OTLP ingest port above)
# TEMPO_ORG_ID=                    # X-Scope-OrgID, multi-tenant Tempo only
# TEMPO_TOKEN=                     # Bearer, e.g. Grafana Cloud
# PROXY_TRACE_WINDOW_H=24          # how far back the Queue tab can see in trace mode
# TRACE_UI_URL=                    # e.g. http://localhost:3001/explore?...&traceId={trace}
#                                  # → enables the per-row "trace" link in the Queue tab
#
# all (default) | sampled | errors | off
# PROXY_REQUEST_STORE=all
# PROXY_REQUEST_STORE_RATIO=0.05   # `sampled` mode only
# PROXY_HISTORY_SOURCE=auto        # auto | db | trace (auto follows PROXY_REQUEST_STORE)

# Logging. LOG_JSON=1 makes the WHOLE stdout stream JSON (access lines, module logs
# and tracebacks alike) and silences uvicorn's duplicate access line; set
# LOG_UVICORN_ACCESS=1 to keep uvicorn's.
# LOG_JSON=1
# LOG_UVICORN_ACCESS=1
