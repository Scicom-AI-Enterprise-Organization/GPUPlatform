# ---------------------------------------------------------------------------
# Web env for a TRIMMED production deployment.
#
# This profile ships five surfaces — Benchmark, Storage, Models, Datasets and
# API Proxy — and turns everything else off. Copy to `.env.production` (or set
# these in your deployment's env) and fill in the values marked <…>.
#
# ⚠ DISABLED_SECTIONS is read SERVER-SIDE at request time (it is deliberately not
#   NEXT_PUBLIC), so a change needs a restart, not a rebuild.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_GATEWAY_URL=<https://gateway.example.com>
# Server-to-server URL, if the gateway is reachable internally on a different
# host (falls back to NEXT_PUBLIC_GATEWAY_URL when unset).
NEXT_PUBLIC_GATEWAY_INTERNAL_URL=
GATEWAY_API_KEY=<sgpu_…>

# Self-service signup off for an internal deployment.
REGISTRATION_DISABLED=1

# ---------------------------------------------------------------------------
# The trim. Each key removes the sidebar entry AND makes its routes 404 — the
# pages are gone, not merely unlinked, so a bookmarked URL doesn't get in.
#
#   KEPT      benchmark · storage · catalog (Models) · datasets · proxy
#   REMOVED   inference · autotrain · quantization · compute · experiments
#             providers · gitops · manage
#
# `manage` is the admin "Manage" group (Compute approvals + Provisioned); it has
# no surface of its own, so one key covers the group and both its routes.
# ---------------------------------------------------------------------------
DISABLED_SECTIONS=inference,autotrain,quantization,compute,experiments,providers,gitops,manage

# Optional: Slurm bridge, if this deployment has one.
SLURMUI_URL=
SLURMUI_API_TOKEN=

# ---------------------------------------------------------------------------
# ⚠ Set DISABLED_SECTIONS on the GATEWAY too — defense in depth.
#
# The web env only hides the UI. The gateway's own DISABLED_SECTIONS denies the
# section to everyone (admins included), so `/auth/me` reports it false and its
# API routes 403. Without it, the endpoints stay open to anyone with a token.
#
# The gateway understands these eight keys (auth.SECTIONS):
#
#     inference  benchmark  compute  datasets
#     autotrain  quantization  catalog  experiments
#
# so the matching line in the gateway env is:
#
#     DISABLED_SECTIONS=inference,autotrain,quantization,compute,experiments
#
# ⚠ `providers`, `gitops`, `manage` and `proxy` are WEB-ONLY keys — the gateway
# has no section gate for those APIs, so hiding them here removes the UI but
# leaves `/v1/providers`, `/v1/gitops` and the proxy admin endpoints reachable
# for a caller with a valid token. Restrict those at the ingress, or with roles,
# if that matters for this deployment.
# ---------------------------------------------------------------------------
